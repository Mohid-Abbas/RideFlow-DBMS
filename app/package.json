{
  "name": "rideflow-app",
  "version": "1.0.0",
  "description": "RideFlow Ride-Hailing Platform - Deliverable 3",
  "main": "server.js",
  "bin": "server.js",
  "pkg": {
    "scripts": "server.js",
    "assets": [
      "public/**/*",
      ".env"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "pkg . --out-path=dist && node create-launcher.js",
    "build-exe": "pkg . --out-path=dist"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "mysql2": "^3.6.0",
    "open": "^8.4.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  },
  "keywords": [
    "ride-hailing",
    "mysql",
    "dbms",
    "rideflow"
  ],
  "author": "RideFlow Team",
  "license": "MIT"
}
